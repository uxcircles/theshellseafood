{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/#story", "permanent": true },
    { "source": "/menus", "destination": "/menu", "permanent": true },
    { "source": "/special", "destination": "/#specials", "permanent": true },
    { "source": "/%E5%89%AF%E6%9C%AC-about", "destination": "/#visit", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
